# RoadWatch Perth environment variables.
# Copy to .env and fill in real values. Never commit .env.
# The Flask CLI loads .env automatically when python-dotenv is installed
# (pip install python-dotenv); otherwise export these in your shell.

# Flask session signing key. Required in production; the dev fallback is insecure.
SECRET_KEY=change-me-to-a-long-random-string

# SQLAlchemy database URL. Defaults to sqlite:///instance/roadwatch.db when unset.
# DATABASE_URL=sqlite:///instance/roadwatch.db

# --- Email sharing (POST /reports/<id>/share/email) ---
# Leave MAIL_SERVER empty to disable email sharing (the share endpoint returns 503).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# SMTP credentials have no defaults. If MAIL_USERNAME is unset, the app sends
# without logging in (only works with an open relay such as a local dev server).
# For Gmail, use an app password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
# From address. Falls back to MAIL_USERNAME, then "RoadWatch Perth <noreply@roadwatch.local>".
# MAIL_DEFAULT_SENDER=RoadWatch Perth <you@example.com>

# --- Selenium tests (pytest -m selenium) ---
# SELENIUM_BROWSER=chrome
# SELENIUM_HEADLESS=1
